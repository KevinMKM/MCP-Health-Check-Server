{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "McpHealthServer": "Debug"
    }
  },
  "AllowedHosts": "*",
  "McpServer": {
    "SessionCleanup": {
      "ExpirationMinutes": 30,
      "CleanupIntervalMinutes": 5
    },
    "HealthCheck": {
      "TimeoutMilliseconds": 3000,
      "MaxRedirects": 3
    },
    "Security": {
      "EnableSsrfProtection": true,
      "AllowedDomains": []
    }
  }
}